<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:viewModels="clr-namespace:LogViewer.ViewModel.Abstractions;assembly=LogViewer.ViewModel"
        x:DataType="viewModels:IMainViewModel"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="LogViewer.View.MainWindow"
        Title="Log Viewer"
        FontSize="14"
        Padding="36"
        Background="{StaticResource Slate100}"
        Foreground="{StaticResource Slate600}">
    <Grid RowDefinitions="60,*">
        <TextBlock Text="Log Viewer"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="{StaticResource Blue600}"
                   Grid.Row="0" />
        <Grid ColumnDefinitions="320,*"
              Grid.Row="1">
            <StackPanel Grid.Column="0"
                        Margin="0,0,24,0"
                        IsVisible="{Binding !IsFileLoaded}">
                <TextBlock Text="Recent Files"
                           FontWeight="Bold"
                           Margin="0,0,0,12" />
                <ListBox ItemsSource="{Binding RecentFiles}"
                         Background="Transparent"
                         Foreground="{StaticResource Slate600}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="Auto,*">
                                <materialIcons:MaterialIcon
                                    Grid.Column="0"
                                    Kind="FolderOpen"
                                    FontSize="20"
                                    Width="20"
                                    Height="20"
                                    Foreground="{StaticResource Slate600}"
                                    Margin="0,0,8,14" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding FileName}"
                                               Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding Path}"
                                               FontSize="12"
                                               Foreground="{StaticResource Slate500}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="12" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="CornerRadius" Value="5" />
                        </Style>
                    </ListBox.Styles>
                </ListBox>
            </StackPanel>
            <Grid Grid.Column="1"
                  DragDrop.AllowDrop="True"
                  IsVisible="{Binding !IsFileLoaded}">
                <Rectangle StrokeThickness="2"
                           Stroke="{StaticResource Slate300}"
                           StrokeDashArray="4,2"
                           RadiusX="5"
                           RadiusY="5"
                           Fill="Transparent"
                           x:Name="DropZoneBorder"/>
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="16"
                            x:Name="DropZone">
                    <materialIcons:MaterialIcon
                        Kind="FileUploadOutline"
                        FontSize="48"
                        Width="48"
                        Height="48"
                        Foreground="{StaticResource Slate600}"
                        x:Name="UploadFileIcon"/>
                    <TextBlock Text="Drag your log file here to start uploading."
                               TextAlignment="Center"
                               Foreground="{StaticResource Slate600}"
                               x:Name="DragFileText" />
                    <TextBlock Text="OR"
                               TextAlignment="Center"
                               Foreground="{StaticResource Slate600}"
                               x:Name="OrText"/>
                    <Button Content="Browse files"
                            HorizontalAlignment="Center"
                            Classes="Primary"
                            Margin="0,0,0,20"
                            x:Name="BrowseButton"
                            Click="BrowseButton_OnClick"/>
                </StackPanel>
            </Grid>
        </Grid>
        <Grid ColumnDefinitions="*"
              RowDefinitions="Auto,*"
              Grid.Row="1"
              IsVisible="{Binding IsFileLoaded}">
            <TabStrip Grid.Row="0"
                      BorderThickness="0,0,0,2"
                      BorderBrush="{StaticResource Slate300}">
                <TabStripItem FontSize="14"
                              FontWeight="SemiBold"
                              Foreground="{StaticResource Slate500}"
                              Padding="0">
                    <Border Background="White"
                            Padding="12,12,6,12">
                        <Grid ColumnDefinitions="Auto,Auto"
                              HorizontalAlignment="Center">
                            <TextBlock Text="log2025.log"
                                       Grid.Column="0"
                                       Margin="0,0,12,0"/>
                            <Button Grid.Column="1"
                                    Background="Transparent"
                                    Padding="0"
                                    Cursor="Hand"
                                    Command="{Binding UnloadLogFile}">
                                <materialIcons:MaterialIcon
                                    Kind="Close"
                                    FontSize="16"
                                    Width="16"
                                    Height="16"
                                    Foreground="{StaticResource Slate500}"/>
                            </Button>
                        </Grid>
                    </Border>
                </TabStripItem>
            </TabStrip>
            <DataGrid x:Name="LogsGrid"
                      AutoGenerateColumns="False"
                      GridLinesVisibility="None"
                      Grid.ColumnSpan="2"
                      Grid.Row="1">
                <DataGrid.Styles>
                    <Style Selector="DataGridColumnHeader">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Foreground" Value="{StaticResource Slate500}"/>
                        <Setter Property="SeparatorBrush" Value="Transparent"/>
                    </Style>
                </DataGrid.Styles>
            </DataGrid>
        </Grid>
    </Grid>
</Window>


